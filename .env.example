# Anthropic API Key - required for legacy spreadsheet assistant
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase (optional for persistence + RLS; in-memory fallback works without these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Encryption secret used for AI provider keys stored in `users.ai_keys`
AI_KEYS_ENCRYPTION_SECRET=change_this_to_a_long_random_secret

# Optional: run lint/tests automatically during bugtracker loop
BUGTRACK_RUN_TESTS=false

# Optional: enable real WPP Connect session startup
WPPCONNECT_ENABLED=false
WHATSAPP_WEBHOOK_SECRET=change_me_for_incoming_webhook_security

# Optional: SuperTokens client-side init for auth pages
NEXT_PUBLIC_SUPERTOKENS_APP_NAME=Hyperplacity AI Workers
NEXT_PUBLIC_SUPERTOKENS_API_DOMAIN=http://localhost:3000
NEXT_PUBLIC_SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3000

# Optional model overrides for multi-provider AI manager
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.0-flash
